{
  "name": "open-synthesia",
  "private": false,
  "version": "1.0.0",
  "description": "Minimalist open-source Synthesia piano studio & visualizer for Linux and Windows",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "gigglemorgan",
  "repository": {
    "type": "git",
    "url": "https://github.com/gigglemorgan/open-synthesia.git"
  },
  "homepage": "https://gigglemorgan.github.io/open-synthesia",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:3000 && electron .\"",
    "electron:preview": "tsc -b && vite build && electron .",
    "build:linux": "tsc -b && vite build && electron-builder --linux AppImage deb",
    "build:win": "tsc -b && vite build && electron-builder --windows nsis portable",
    "pack": "tsc -b && vite build && electron-builder --dir"
  },
  "build": {
    "appId": "com.gigglemorgan.opensynthesia",
    "productName": "OpenSynthesia",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo;Audio;Music",
      "icon": "build/icon.png",
      "maintainer": "gigglemorgan <https://github.com/gigglemorgan>",
      "synopsis": "Minimalist open-source Synthesia piano studio & visualizer"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lamejs": "^1.2.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/webmidi": "^2.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "wait-on": "^9.5.1"
  }
}
